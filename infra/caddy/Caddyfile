# Reverse proxy produksi: HTTPS otomatis (Let's Encrypt) untuk APP_DOMAIN.
#   /api/*    → backend (NestJS)
#   /office/* → ONLYOFFICE Docs (opsional, profile "office"; halaman bawaan/admin ditutup)
#   lainnya   → frontend (nginx, SPA statis)
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /api/* {
		# Batas body sedikit di atas UPLOAD_MAX_MB backend (default 100 MB)
		request_body {
			max_size 110MB
		}
		reverse_proxy backend:4000
	}

	# Halaman bawaan ONLYOFFICE yang tidak dipakai LifeOS (contoh, admin panel, info, selamat datang) ditutup
	@officeBlocked path /office/welcome* /office/example* /office/admin* /office/info*
	handle @officeBlocked {
		respond 404
	}

	# Editor ONLYOFFICE di sub-path /office/ (satu domain → CSP 'self' cukup). X-Forwarded-Host memuat prefix agar
	# ONLYOFFICE membuat URL (api.js, cache berkas, plugin) dengan /office/.
	handle_path /office/* {
		request_body {
			max_size 110MB
		}
		reverse_proxy onlyoffice:80 {
			header_up X-Forwarded-Host {host}/office
		}
	}

	handle {
		reverse_proxy frontend:80
	}

	log {
		output stdout
		format json
	}
}
