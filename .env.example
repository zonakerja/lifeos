# ============================================================================
# Konfigurasi deployment PRODUKSI (docker-compose.prod.yml). Salin ke `.env` lalu isi.
# Development lokal TIDAK memakai file ini (backend memakai backend/.env).
# Buat secret acak: openssl rand -hex 32
# ============================================================================

# Domain publik yang diarahkan (DNS A/AAAA) ke IP VPS. Caddy membuat sertifikat HTTPS otomatis.
APP_DOMAIN=lifeos.example.com
# Email untuk notifikasi Let's Encrypt
ACME_EMAIL=admin@example.com
# Tag image yang dibangun (opsional, mis. tanggal rilis)
APP_VERSION=latest

# --- Secret aplikasi (WAJIB, min. 16 karakter) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Kunci enkripsi API key AI milik user: WAJIB 64 karakter hex (openssl rand -hex 32).
# Simpan di password manager — bila hilang/diganti, semua user harus memasukkan ulang API key AI-nya.
AI_ENCRYPTION_KEY=

# --- Database & Redis (WAJIB) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Object storage ---
# Default: SeaweedFS internal. Untuk S3/R2/B2 eksternal isi juga S3_ENDPOINT (+ S3_REGION).
S3_ACCESS_KEY_ID=lifeos
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# ASSET_BUCKET=lifeos-assets
# UPLOAD_MAX_MB=100

# --- Super admin awal (seed produksi, password min. 8 karakter) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Backup harian (service `backup`, docs/DEPLOYMENT.md §4) ---
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14

# Salinan luar server (SANGAT DISARANKAN): bucket S3-compatible terpisah, mis. Cloudflare R2 / Backblaze B2.
# Kosongkan OFFSITE_S3_BUCKET untuk menonaktifkan. Isi & nama berkas dienkripsi dengan BACKUP_ENCRYPTION_PASSWORD
# — simpan password ini di password manager: tanpa password ini backup luar server TIDAK BISA dibuka.
# OFFSITE_S3_PROVIDER=Cloudflare            # Cloudflare | Other (B2, Wasabi, dll.)
# OFFSITE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OFFSITE_S3_REGION=auto
# OFFSITE_S3_ACCESS_KEY_ID=
# OFFSITE_S3_SECRET_ACCESS_KEY=
# OFFSITE_S3_BUCKET=
# OFFSITE_S3_PREFIX=lifeos
# OFFSITE_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_PASSWORD=               # openssl rand -hex 32

# Pemantauan backup: URL ping healthchecks.io (dipanggil saat sukses, <url>/fail saat gagal)
# BACKUP_HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# --- Editor dokumen ONLYOFFICE (opsional; butuh VPS 8 GB, docs/DEPLOYMENT.md §9) ---
# Aktifkan service onlyoffice + isi URL publik (= https://<APP_DOMAIN>/office) dan secret JWT (openssl rand -hex 32).
# COMPOSE_PROFILES=office
# ONLYOFFICE_URL=https://lifeos.example.com/office
# ONLYOFFICE_JWT_SECRET=
# ONLYOFFICE_MEM_LIMIT=2560m

# --- Batas memori container (default untuk VPS 4 GB; VPS 2 GB: docs/DEPLOYMENT.md §1.1) ---
# POSTGRES_MEM_LIMIT=1g
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=64MB
# BACKEND_MEM_LIMIT=768m
# BACKEND_HEAP_MB=512
# REDIS_MEM_LIMIT=256m
# REDIS_MAXMEMORY=192mb
# STORAGE_MEM_LIMIT=512m

# LOG_LEVEL=info

# Uji coba tanpa domain/HTTPS saja (lihat docs/DEPLOYMENT.md §0.4). Jangan dipakai untuk data sungguhan.
# COOKIE_SECURE=false
