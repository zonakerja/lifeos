{
  "name": "lifeos-robot",
  "version": "0.1.0",
  "private": true,
  "description": "Service robot browser LifeOS (Playwright): login jarak jauh, cek sesi, eksplor halaman untuk konektor SRIKANDI & e-Kinerja",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
