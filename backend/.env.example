NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/lifeos?schema=public"

# Wajib minimal 16 karakter. Ganti untuk produksi (mis. `openssl rand -hex 32`).
JWT_ACCESS_SECRET="change-me-access-secret-dev"
JWT_REFRESH_SECRET="change-me-refresh-secret-dev"
# Format: angka + satuan (ms|s|m|h|d)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Pisahkan dengan koma untuk beberapa origin
CORS_ORIGIN="http://localhost:5173"

REDIS_HOST="localhost"
REDIS_PORT=6380
# REDIS_PASSWORD=
EXTRACTION_CONCURRENCY=2

# Object storage S3-compatible (dev: SeaweedFS dari docker-compose root)
S3_ENDPOINT="http://localhost:9002"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="lifeos"
S3_SECRET_ACCESS_KEY="lifeos-secret"
S3_FORCE_PATH_STYLE=true
ASSET_BUCKET="lifeos-assets"
UPLOAD_MAX_MB=100

# true bila API di belakang reverse proxy (mis. nginx di docker-compose produksi)
TRUST_PROXY=false
# Cookie refresh token hanya via HTTPS (default: true bila NODE_ENV=production)
# COOKIE_SECURE=false

# Level log: fatal|error|warn|info|debug|trace|silent (default: info di production, debug di dev)
# LOG_LEVEL=info
