  requestKind      String   @map("request_kind")
  /// Kode grup kontak yang diizinkan; kosong = semua grup
  groupCodes       Json     @default("[]") @map("group_codes")
  /// off | shadow (hanya mencatat) | auto (memutuskan & menyimpan konsep SRIKANDI)
  mode             String   @default("shadow")
  /// Persen aset yang harus cocok (0–100)
  threshold        Int      @default(75)
  /// Kolom yang wajib sama persis: ["nup", "kodeBarang", …]
  criticalFields   Json     @default("[\"nup\",\"kodeBarang\"]") @map("critical_fields")
  /// Toleransi selisih nilai aset (persen)
  valueTolerance   Float    @default(0) @map("value_tolerance")
  /// Keputusan otomatis maksimal per hari
  dailyLimit       Int      @default(5) @map("daily_limit")
  /// Masa tunda sebelum konsep disimpan ke SRIKANDI (menit)
  holdMinutes      Int      @default(15) @map("hold_minutes")
  /// Entri Register Naskah Keluar yang isiannya disalin (jenis, sifat, klasifikasi, tujuan, verifikator, penandatangan)
  registerTemplate String?  @map("register_template")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("agent_policies")
}

