/// Aturan milik user: pengajuan jenis/grup tertentu dikerjakan skill agen, lalu diputuskan server (bukan model).
model AgentPolicy {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  name             String
  /// Skill LifeOS yang dijalankan (folder agents/hermes/skills)
  skill            String
