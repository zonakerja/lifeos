// ============================================================================
// LifeOS — skema database
// Konvensi: model PascalCase, tabel & kolom snake_case (@@map/@map), timestamp
// timestamptz(3), soft delete via deleted_at pada tabel domain.
// Model domain di antara marker <generated:domain-models> DIBUAT OTOMATIS dari
// src/records/record-schema.ts — jangan diedit manual (npm run db:generate-models).
// ============================================================================

// Client hasil generate (src/generated/prisma, tidak di-commit). Prisma 7 selalu tanpa
// engine Rust (driver adapter pg), cocok untuk Windows ARM64. Proyek CommonJS → moduleFormat cjs.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

// URL koneksi diatur di prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  admin
  member

  @@map("user_role")
}

enum AssetStatus {
  uploaded
  queued
  extracting
  ready
  failed

  @@map("asset_status")
}

enum AssetExtractionStatus {
  pending
  extracting
  completed
  unsupported
  failed

  @@map("asset_extraction_status")
}

enum AuditAction {
  created
  updated
  deleted

  @@map("audit_action")
}

// Tingkat izin berbagi item (shares): view = baca, comment = baca + komentar, edit = ubah isi & tambah turunan
enum SharePermission {
  view
  comment
  edit

  @@map("share_permission")
}

enum AiProvider {
  gemini
  anthropic
  openai

  @@map("ai_provider")
}

// ---------------------------------------------------------------- Identitas

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  passwordHash   String      @map("password_hash")
  role           UserRole    @default(member)
  phone          String?
  address        String?
  // Provider AI yang dipakai user (kredensialnya di ai_credentials)
  aiProvider     AiProvider? @map("ai_provider")
  // Cadangan otomatis: provider lain (yang punya key) dipakai bila provider aktif kehabisan kuota, tidak terjangkau,
  // atau tidak mendukung lampiran
  aiFallback     Boolean     @default(true) @map("ai_fallback")
  // Indeks pengetahuan (RAG): data user di-embed dengan Gemini; dimatikan = indeks dihapus & tidak ada data dikirim
  aiIndexEnabled Boolean     @default(true) @map("ai_index_enabled")
  // AI di editor ONLYOFFICE (tab AI memakai provider & key LifeOS); default mati agar isi dokumen tidak terkirim tanpa disadari
  officeAi       Boolean     @default(false) @map("office_ai")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens             RefreshToken[]
  assets                    Asset[]
  aiCredentials             AiCredential[]
  aiChunks                  AiChunk[]
  // <generated:user-relations>
  agendaTypes               AgendaType[]
  schedules                 Schedule[]
  routines                  Routine[]
  todos                     Todo[]
  routineCompletions        RoutineCompletion[]
  freeNotes                 FreeNote[]
  aiNotes                   AiNote[]
  noteLists                 NoteList[]
  areas                     Area[]
  projects                  Project[]
  activities                Activity[]
  tasks                     Task[]
  resources                 Resource[]
  paraArchives              ParaArchive[]
  paraArchiveLogs           ParaArchiveLog[]
  archiveClassifications    ArchiveClassification[]
  archiveRetentionSchedules ArchiveRetentionSchedule[]
  archiveLocations          ArchiveLocation[]
  archiveBorrowings         ArchiveBorrowing[]
  archiveDispositions       ArchiveDisposition[]
  archiveMoveLogs           ArchiveMoveLog[]

  // </generated:user-relations>
  archiveAuditLogs ArchiveAuditLog[]
  sharesOwned      Share[]           @relation("SharesOwned")
  sharesReceived   Share[]           @relation("SharesReceived")
  commentsOnOwned  RecordComment[]   @relation("CommentsOnOwned")
  commentsAuthored RecordComment[]   @relation("CommentsAuthored")
  notebooks        Notebook[]

  @@map("users")
}

model RefreshToken {
  // id dipakai sebagai claim `jti` pada refresh token JWT
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // SHA-256 (hex) dari refresh token
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// API key AI per user per provider, terenkripsi AES-256-GCM (AI_ENCRYPTION_KEY); tidak pernah dikirim ke browser.
model AiCredential {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  provider     AiProvider
  encryptedKey String     @map("encrypted_key")
  // 4 karakter terakhir key, untuk ditampilkan di Pengaturan
  keyHint      String     @map("key_hint")
  // Kosong = model default provider (src/ai/ai-providers.ts)
  model        String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("ai_credentials")
}

model AppSettings {
  id           String   @id @default("global")
  name         String   @default("LifeOS")
  navSub       String   @default("Integrated Edition") @map("nav_sub")
  loginSub     String   @default("Ultimate") @map("login_sub")
  motto        String   @default("Design Your Life, Manage Your Resources")
  welcomeTitle String   @default("Selamat Datang") @map("welcome_title")
  welcomeSub   String   @default("Silakan masuk menggunakan User ID dan Password Anda.") @map("welcome_sub")
  footerText   String   @default("© 2026 LifeOS System") @map("footer_text")
  // Logo aplikasi sebagai data URL (maks ~1 MB); disajikan lewat GET /settings/app/logo
  appLogo      String?  @map("app_logo")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

// Potongan teks data user + embedding untuk RAG (src/ai/index/). Indeks HNSW (vector) dan GIN (full-text) dibuat
// dengan SQL di migrasi karena tidak bisa dinyatakan di skema Prisma.
// ---------------------------------------------------------------- My Notebook (RAG ala NotebookLM, src/notebooks/)

enum NotebookSourceKind {
  /// Berkas yang diunggah (asset; teks dari asset_extractions)
  upload
  /// Item LifeOS milik user (record_type + record_id)
  record
  /// Teks yang ditempel user
  text
  /// Halaman web yang diambil server
  web
}

/// Notebook: kumpulan sumber + percakapan + catatan hasil.
model Notebook {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  title       String
  description String?
  icon        String?
  /// Ringkasan Studio: { overview, keyPoints[], questions[] }
  summary     Json?
  /// Sidik jari sumber saat ringkasan dibuat (beda ⇒ ringkasan usang)
  summaryHash String?           @map("summary_hash")
  summaryAt   DateTime?         @map("summary_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources     NotebookSource[]
  messages    NotebookMessage[]
  notes       NotebookNote[]

  @@index([userId, updatedAt])
  @@map("notebooks")
}

model NotebookSource {
  id         String             @id @default(cuid())
  notebookId String             @map("notebook_id")
  kind       NotebookSourceKind
  title      String
  /// Dipakai saat chat/ringkasan (bisa dimatikan sementara)
  enabled    Boolean            @default(true)
  assetId    String?            @map("asset_id")
  recordType String?            @map("record_type")
  recordId   String?            @map("record_id")
  url        String?
  /// Isi teks (jenis text & web)
  content    String?
  /// Error terakhir (mis. halaman web gagal diambil)
  error      String?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  notebook   Notebook           @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId])
  @@map("notebook_sources")
}

model NotebookMessage {
  id          String   @id @default(cuid())
  notebookId  String   @map("notebook_id")
  /// user | assistant
  role        String
  content     String
  /// Sitasi jawaban: [{ n, sourceId, title, excerpt }]
  citations   Json?
  /// Gambar yang dilampirkan pengguna: [{ uploadId, name, mimeType }]
  attachments Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId, createdAt])
  @@map("notebook_messages")
}

/// Catatan hasil di dalam notebook (disimpan dari chat/ringkasan atau ditulis manual), Markdown.
model NotebookNote {
  id         String   @id @default(cuid())
  notebookId String   @map("notebook_id")
  title      String
  content    String
  /// chat | summary | manual
  origin     String   @default("manual")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId, updatedAt])
  @@map("notebook_notes")
}

model AiChunk {
  id          String                      @id @default(cuid())
  userId      String                      @map("user_id")
  // Record type (mis. "free_note") atau "asset" untuk isi berkas
  sourceType  String                      @map("source_type")
  // clientId record atau id asset
  sourceId    String                      @map("source_id")
  chunkIndex  Int                         @map("chunk_index")
  title       String
  content     String
  contentHash String                      @map("content_hash")
  // Model embedding yang dipakai (ganti model ⇒ indeks ulang)
  model       String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, chunkIndex])
  @@index([userId, sourceType, sourceId])
  @@map("ai_chunks")
}

// ---------------------------------------------------------------- Aset & berkas

model Asset {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  bucket          String
  objectKey       String           @unique @map("object_key")
  originalName    String           @map("original_name")
  mimeType        String           @map("mime_type")
  size            Int
  checksum        String
  status          AssetStatus      @default(uploaded)
  source          String           @default("upload")
  context         String?
  // Pengunggah bila berbeda dari pemilik (kolaborator dengan izin edit mengunggah ke item milik user lain)
  uploadedById    String?          @map("uploaded_by_id")
  // Editor ONLYOFFICE: nomor versi isi saat ini, siapa yang menyimpannya, dan kunci sesi edit (berganti setiap kali
  // dokumen selesai disimpan; document.key = "<id>-<officeKey>")
  version         Int              @default(1)
  versionAuthorId String?          @map("version_author_id")
  officeKey       String?          @map("office_key")
  // Waktu isi saat ini disimpan (updated_at ikut berubah oleh ekstraksi, jadi tidak bisa dipakai); null = createdAt
  versionedAt     DateTime?        @map("versioned_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  extraction      AssetExtraction?
  versions        AssetVersion[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([checksum])
  @@map("assets")
}

model AssetExtraction {
  id            String                @id @default(cuid())
  assetId       String                @unique @map("asset_id")
  status        AssetExtractionStatus @default(pending)
  extractedText String?               @map("extracted_text")
  summary       String?
  metadata      Json?
  error         String?
  startedAt     DateTime?             @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?             @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  asset         Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("asset_extractions")
}

/// Versi sebelumnya dari berkas yang diedit di ONLYOFFICE (isi saat ini tetap di `assets`). Dibatasi beberapa versi
/// terakhir per berkas; objek storage versi yang dipangkas ikut dihapus.
model AssetVersion {
  id         String   @id @default(cuid())
  assetId    String   @map("asset_id")
  version    Int
  objectKey  String   @unique @map("object_key")
  size       Int
  checksum   String
  // Penulis isi versi ini (null = pengunggah awal / tidak diketahui)
  authorId   String?  @map("author_id")
  // Sesi edit ONLYOFFICE yang menggantikan versi ini: penyimpanan berikutnya di sesi yang sama tidak membuat versi baru
  sessionKey String?  @map("session_key")
  // Waktu isi versi ini dibuat (bukan waktu digantikan)
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@map("asset_versions")
}

// ---------------------------------------------------------------- Audit kearsipan

/// Jejak perubahan data kearsipan (File Control): siapa, kapan, field apa, sebelum → sesudah.
model ArchiveAuditLog {
  id         String      @id @default(cuid())
  /// Pemilik data
  userId     String      @map("user_id")
  /// Pelaku perubahan (pemilik, atau kolaborator dengan izin edit lewat berbagi)
  actorId    String?     @map("actor_id")
  /// Record type, mis. archive_borrowing / para_resource
  entityType String      @map("entity_type")
  /// ID entitas buatan client
  entityId   String      @map("entity_id")
  action     AuditAction
  /// { field: { from, to } } untuk update; snapshot lengkap untuk created/deleted
  changes    Json
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType, entityId])
  @@index([createdAt])
  @@map("archive_audit_logs")
}

// ---------------------------------------------------------------- Berbagi & komentar

/// Item yang dibagikan pemilik ke user lain (src/sharing/). Turunan item (mis. action project) dan berkasnya ikut
/// dapat diakses; dihitung saat request, tidak disimpan.
model Share {
  id          String          @id @default(cuid())
  ownerId     String          @map("owner_id")
  recipientId String          @map("recipient_id")
  /// Record type item induk, mis. para_project
  recordType  String          @map("record_type")
  /// clientId item induk milik owner
  recordId    String          @map("record_id")
  permission  SharePermission @default(view)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner       User            @relation("SharesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient   User            @relation("SharesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([ownerId, recordType, recordId, recipientId])
  @@index([recipientId])
  @@map("shares")
}

/// Komentar pada item milik owner (pemilik & penerima berbagi dengan izin comment/edit).
model RecordComment {
  id         String   @id @default(cuid())
  /// Pemilik item yang dikomentari
  ownerId    String   @map("owner_id")
  recordType String   @map("record_type")
  recordId   String   @map("record_id")
  authorId   String   @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner      User     @relation("CommentsOnOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  author     User     @relation("CommentsAuthored", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ownerId, recordType, recordId, createdAt])
  @@map("record_comments")
}

// ---------------------------------------------------------------- Domain (generated)

// <generated:domain-models>
/// Record type `agenda_type`
model AgendaType {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  clientId  String    @map("client_id")
  name      String?
  order     Int?
  extra     Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt])
  @@map("agenda_types")
}

/// Record type `schedule`
model Schedule {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  clientId  String    @map("client_id")
  title     String?
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  date      DateTime? @db.Date
  startTime String?   @map("start_time")
  endTime   String?   @map("end_time")
  time      String?
  isAllDay  Boolean?  @map("is_all_day")
  type      String?
  location  String?
  media     String?
  projectId String?   @map("project_id")
  extra     Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt])
  @@index([userId, startDate])
  @@index([userId, projectId])
  @@map("schedules")
}

/// Record type `routine`
model Routine {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  clientId      String    @map("client_id")
  title         String?
  frequency     String?
  days          Json?
  interval      Int?
  intervalType  String?   @map("interval_type")
  monthDates    Json?     @map("month_dates")
  startDate     DateTime? @map("start_date") @db.Date
  active        Boolean?
  archived      Boolean?
  freezePeriods Json?     @map("freeze_periods")
  extra         Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt])
  @@map("routines")
}

/// Record type `todo`
model Todo {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  clientId  String    @map("client_id")
  title     String?
  completed Boolean?
  date      DateTime? @db.Date
  priority  String?
  extra     Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt])
  @@index([userId, date])
  @@map("todos")
}

/// Record type `completion`
model RoutineCompletion {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  clientId    String    @map("client_id")
  routineId   String?   @map("routine_id")
  date        DateTime? @db.Date
  actualDate  DateTime? @map("actual_date") @db.Date
  note        String?
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  extra       Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt])
  @@index([userId, routineId, date])
  @@map("routine_completions")
}

/// Record type `free_note`
model FreeNote {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  clientId  String    @map("client_id")
  title     String?
  content   String?
  color     String?
  extra     Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt])
  @@map("free_notes")
}

/// Record type `ai_note`
model AiNote {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  clientId         String    @map("client_id")
  title            String?
  date             DateTime? @db.Date
  linkedScheduleId String?   @map("linked_schedule_id")
  content          String?
  aiSummary        String?   @map("ai_summary")
  audioTranscript  String?   @map("audio_transcript")
  fileContext      String?   @map("file_context")
  hasAudio         Boolean?  @map("has_audio")
  audioUploadId    String?   @map("audio_upload_id")
  fileAttachment   Json?     @map("file_attachment")
  extra            Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt])
  @@index([userId, date])
  @@map("ai_notes")
}

/// Record type `list`
model NoteList {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  clientId  String    @map("client_id")
  title     String?
  archived  Boolean?
  items     Json?
  extra     Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
