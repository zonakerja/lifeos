// ---------------------------------------------------------------- Pengajuan & Antrian Verifikasi

/// Pengajuan / surat masuk dari pemohon (satker, instansi, masyarakat, …) yang diproses bersama agen.
model Request {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  /// psp | penghapusan | pemanfaatan | surat | lainnya
  kind            String
  title           String
  /// Nama pemohon (satker / instansi / perorangan)
  applicant       String?
  /// Kode grup kontak pemohon (menentukan siapa yang boleh melihat status pengajuan ini)
  groupCode       String?  @map("group_code")
  letterNumber    String?  @map("letter_number")
  /// Tanggal surat YYYY-MM-DD
  letterDate      String?  @map("letter_date")
  subject         String?
  /// Isi pesan / permintaan pemohon (mis. dari WhatsApp)
  message         String?
  /// baru | diproses | menunggu_verifikasi | disetujui | dikirim | ditolak
  status          String   @default("baru")
  /// manual | whatsapp | mcp
  source          String   @default("manual")
  /// Kontak WhatsApp pengirim (pengajuan dari bot WhatsApp; status dikabarkan ke nomor ini)
  waContactId     String?  @map("wa_contact_id")
  /// Berkas dari pemohon: [{ uploadId, name, mimeType }]
  attachments     Json     @default("[]")
  /// Hasil analisis AI: { summary, fields, checklist[], missing[], suggestion, sources[], analyzedAt }
  analysis        Json?
  /// Telaah (Markdown, sitasi [n]) + sumbernya
  review          String?
  reviewCitations Json?    @map("review_citations")
  /// Konsep jawaban / isi surat (Markdown)
  draftReply      String?  @map("draft_reply")
  /// Dokumen yang dibuat dari templat: [{ uploadId, name, templateName, createdAt }]
  documents       Json     @default("[]")
  notes           String?
  /// Riwayat status: [{ at, status, note?, by }]
  history         Json     @default("[]")
  /// Verifikasi aset oleh server: { source, checkedAt, score, matched, total, items[{ claimed, status, diffs[] }] }
  assetCheck      Json?    @map("asset_check")
  /// Keputusan Kebijakan Otomatis: { policyId, policyName, mode, outcome, applied, reasons[], score, decidedAt,
  /// registerId?, sendAt?, sentAt?, cancelledAt?, error? }
  autoDecision    Json?    @map("auto_decision")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([waContactId])
  @@map("requests")
}

// ---------------------------------------------------------------- Bot WhatsApp (tahap 5)

/// Grup kontak (satker, instansi, masyarakat umum, unit layanan, …). Grup yang di-assign ke kontak menentukan data yang
/// boleh diaksesnya lewat bot (AG-20): pengetahuan publik + catatan berproperti `grup` = kode ini, pengajuan grup, dsb.
model ContactGroup {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  /// Kode unik per user (mis. kode satker SIMAN); dipakai menyaring data grup
  code          String
  name          String
  /// satker | instansi | masyarakat | internal | lainnya
  kind          String      @default("lainnya")
  notes         String?
  /// Anggota boleh mengirim berkas pengajuan lewat bot
  allowRequests Boolean     @default(true) @map("allow_requests")
  /// Anggota boleh melihat status pengajuan seluruh grup (mati = hanya pengajuan miliknya sendiri)
  shareRequests Boolean     @default(false) @map("share_requests")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts      WaContact[]

  @@unique([userId, code])
  @@map("contact_groups")
}

/// Nomor WhatsApp yang boleh memakai bot. Grup pengirim diambil dari sini (server), tidak pernah dari isi pesan.
model WaContact {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  groupId       String?       @map("group_id")
  /// Nomor internasional tanpa + (mis. 6281234567890)
  phone         String
  name          String
  position      String?
  /// Terverifikasi = boleh bertanya & mengajukan; belum = hanya dicatat
  verified      Boolean       @default(false)
  active        Boolean       @default(true)
  notes         String?
  lastInboundAt DateTime?     @map("last_inbound_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         ContactGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([userId, phone])
  @@map("wa_contacts")
}

/// Pesan masuk/keluar bot WhatsApp (audit percakapan; juga hasil simulator).
model WaMessage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  contactId   String?  @map("contact_id")
  phone       String
  /// in | out
  direction   String
  text        String   @default("")
  /// Berkas: [{ uploadId?, mediaId?, name, mimeType }]
  attachments Json     @default("[]")
  /// ID pesan WhatsApp (dedupe webhook)
  waMessageId String?  @unique @map("wa_message_id")
  /// Masuk: received | answered | needs_reply | ignored. Keluar: sent | simulated | failed
  status      String
  /// question | request | status | unregistered | off_topic | rate_limited | manual | notice
  intent      String?
  requestId   String?  @map("request_id")
  citations   Json?
  error       String?
  simulated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phone, createdAt])
  @@index([userId, status])
  @@map("wa_messages")
}

// ---------------------------------------------------------------- Konektor robot SRIKANDI & e-Kinerja (tahap 6)

/// Konektor robot per user per sistem. Menyimpan sesi browser (cookie/storage) TERENKRIPSI — tidak pernah kata sandi
/// atau rahasia OTP; pengguna sendiri yang login lewat browser jarak jauh.
model RobotConnector {
  id                   String     @id @default(cuid())
  userId               String     @map("user_id")
  /// srikandi | ekinerja
  system               String
  baseUrl              String     @map("base_url")
  /// Host tambahan yang boleh dibuka robot (mis. server SSO)
  extraHosts           Json       @default("[]") @map("extra_hosts")
  /// Penanda alamat halaman login khusus sistem ini
  loginMarkers         Json       @default("[]") @map("login_markers")
  /// none | active | expired | error
  status               String     @default("none")
  /// storageState Playwright terenkripsi AES-256-GCM
  sessionEnc           String?    @map("session_enc")
  /// Brankas kredensial (AES-256-GCM, kunci CREDENTIAL_ENCRYPTION_KEY, AAD = user+sistem+kolom). Tidak pernah dikirim ke browser.
  usernameEnc          String?    @map("username_enc")
  passwordEnc          String?    @map("password_enc")
  /// Nama pengguna tersamar untuk ditampilkan (mis. "Yu•••EU")
  credentialHint       String?    @map("credential_hint")
  credentialsUpdatedAt DateTime?  @map("credentials_updated_at") @db.Timestamptz(3)
  lastLoginAt          DateTime?  @map("last_login_at") @db.Timestamptz(3)
  lastCheckAt          DateTime?  @map("last_check_at") @db.Timestamptz(3)
  lastUrl              String?    @map("last_url")
  lastError            String?    @map("last_error")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                 RobotRun[]

  @@unique([userId, system])
  @@map("robot_connectors")
}

/// Log setiap pekerjaan robot (login, cek sesi, eksplor halaman, nanti alur pengisian) + tangkapan layar.
model RobotRun {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  connectorId   String         @map("connector_id")
  /// login | check | capture
  kind          String
  /// ok | failed
