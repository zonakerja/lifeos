{
  "name": "lifeos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LifeOS backend API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.prisma\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node test/smoke.mjs",
    "db:generate-models": "node --no-warnings prisma/generate-domain-models.mts && prisma format",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.6",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "@nestjs/core": false,
    "@scarf/scarf": false
  },
  "engines": {
    "node": ">=24"
  }
}
